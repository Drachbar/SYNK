# Kopieras till /etc/synk/synk.env (chmod 600, ägs av root). Se docs/drift.md.

# Databasen på databas-VM:en. Lägg till ?sslmode=require om Postgres har TLS påslaget.
SPRING_DATASOURCE_URL=jdbc:postgresql://DB_VM:5432/synk
SPRING_DATASOURCE_USERNAME=synk
SPRING_DATASOURCE_PASSWORD=byt-mig

# Kakorna får bara skickas över HTTPS (nginx-proxyn terminerar TLS).
SERVER_SERVLET_SESSION_COOKIE_SECURE=true

# Om proxy-VM:en inte ansluter från en privat adress (10.x, 172.16-31.x, 192.168.x, 100.64.x)
# måste dess adress anges här, annars litar appen inte på X-Forwarded-Proto. Regex.
#SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=203\\.0\\.113\\.10
